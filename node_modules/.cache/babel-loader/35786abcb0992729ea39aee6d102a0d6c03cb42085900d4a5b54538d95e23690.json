);\n    setOpen(false);\n  };\n\n  return (\n    <nav className={`nav${scrolled ? ' scrolled' : ''}`}>\n      <div className=\"nav-logo\">M<span>.</span>Ahmad</div>\n\n      <ul className={`nav-links${open ? ' open' : ''}`}>\n        {LINKS.map(l => (\n          <li key={l}>\n            <a\n              href={`#${l}`}\n              className={activeSection === l ? 'active' : ''}\n              onClick={e => { e.preventDefault(); scrollTo(l); }}\n            >\n              {l.charAt(0).toUpperCase() + l.slice(1)}\n            </a>\n          </li>\n        ))}\n      </ul>\n\n      <button className={`hamburger${open ? ' open' : ''}`} onClick={() => setOpen(o => !o)}>\n        <span /><span /><span />\n      </button>\n    </nav>\n  );\n}\n"],"mappings":"AAAA,OAASA,QAAQ,KAAQ,OAAO,CAChC,MAAO,cAAc,CAAC,OAAAC,GAAA,IAAAC,IAAA,CAAAC,IAAA,IAAAC,KAAA,yBAEtB,KAAM,CAAAC,KAAK,CAAG,CAAC,MAAM,CAAE,OAAO,CAAE,QAAQ,CAAE,UAAU,CAAE,SAAS,CAAC,CAEhE,cAAe,SAAS,CAAAC,MAAMA,CAAAC,IAAA,CAA8B,IAA7B,CAAEC,QAAQ,CAAEC,aAAc,CAAC,CAAAF,IAAA,CACxD,KAAM,CAACG,IAAI,CAAEC,OAAO,CAAC,CAAGX,QAAQ,CAAC,KAAK,CAAC,CAEvC,KAAM,CAAAY,QAAQ,CAAIC,EAAE,EAAK,CACvB,KAAM,CAAAC,EAAE,CAAGC,QAAQ,CAACC,cAAc,CAACH,EAAE,CAAC,CACtC,GAAI,CAACC,EAAE,CAAE,OACTG,MAAM,CAACL,QAAQ,CAAC,CAAEM,GAAG,CAAEJ,EAAE,CAACK,SAAS,CAAG,EAAE,CAAEC,QAAQ,CAAE,QAAS,CAAC,CAAC,CAC/DT,OAAO,CAAC,KAAK,CAAC,CAChB,CAAC,CAED,mBACEP,KAAA,QAAKiB,SAAS,CAAE,MAAMb,QAAQ,CAAG,WAAW,CAAG,EAAE,EAAG,CAAAc,QAAA,eAClDlB,KAAA,QAAKiB,SAAS,CAAC,UAAU,CAAAC,QAAA,EAAC,GAAC,cAAApB,IAAA,SAAAoB,QAAA,CAAM,GAAC,CAAM,CAAC,QAAK,EAAK,CAAC,cAEpDpB,IAAA,OAAImB,SAAS,CAAE,YAAYX,IAAI,CAAG,OAAO,CAAG,EAAE,EAAG,CAAAY,QAAA,CAC9CjB,KAAK,CAACkB,GAAG,CAACC,CAAC,eACVtB,IAAA,OAAAoB,QAAA,cACEpB,IAAA,MACEuB,IAAI,CAAE,IAAID,CAAC,EAAG,CACdH,SAAS,CAAEZ,aAAa,GAAKe,CAAC,CAAG,QAAQ,CAAG,EAAG,CAC/CE,OAAO,CAAEC,CAAC,EAAI,CAAEA,CAAC,CAACC,cAAc,CAAC,CAAC,CAAEhB,QAAQ,CAACY,CAAC,CAAC,CAAE,CAAE,CAAAF,QAAA,CAElDE,CAAC,CAACK,MAAM,CAAC,CAAC,CAAC,CAACC,WAAW,CAAC,CAAC,CAAGN,CAAC,CAACO,KAAK,CAAC,CAAC,CAAC,CACt